# ============================================================================
# ShopSphere Marketplace — Environment Variables Example
# ============================================================================

# Frontend Port (Default: 5173)
PORT=5173

# Optional Base Path (Default: /)
BASE_PATH=/

# Backend API Configuration
JWT_SECRET=shopsphere-marketplace-jwt-secret-key-32-bytes-secure-2026
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
